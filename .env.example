# Copy to .env and fill in. Never commit the real .env.

# --- Database ---
DATABASE_URL="postgresql://rankly:rankly_dev_only@localhost:5432/rankly"

# --- Auth ---
# No signing secret needed: sessions are opaque random tokens, only their
# SHA-256 hash is stored server-side (see src/lib/auth/session.ts).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# --- SEO data providers (adapters fall back to mock data until these are set) ---
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""
SERP_API_KEY=""

# --- AI provider (content assistant / keyword clustering) ---
ANTHROPIC_API_KEY=""

# --- Billing (Stripe) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Price IDs from your Stripe dashboard, one per plan/interval. Leave unset and that
# plan's checkout will return a clear 501 instead of silently failing.
STRIPE_PRICE_STARTER_MONTHLY=""
STRIPE_PRICE_STARTER_ANNUAL=""
STRIPE_PRICE_GROWTH_MONTHLY=""
STRIPE_PRICE_GROWTH_ANNUAL=""
STRIPE_PRICE_SCALE_MONTHLY=""
STRIPE_PRICE_SCALE_ANNUAL=""

# --- Outbound email (transactional, via Resend) ---
# Leave unset and emails (verification, password reset, team invites) won't be
# sent — the app falls back to showing the link directly instead of failing.
RESEND_API_KEY=""
EMAIL_FROM="Rankly <noreply@yourdomain.com>"
