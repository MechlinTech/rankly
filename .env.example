# Copy to .env and fill in. Never commit the real .env.
# --- Canonical public URL (used in emails, OAuth/Stripe redirects) ---
APP_URL="http://localhost:3000"

# --- Database ---
DATABASE_URL="postgresql://rankly:rankly_dev_only@localhost:5432/rankly"

# --- Auth ---
# No signing secret needed: sessions are opaque random tokens, only their
# SHA-256 hash is stored server-side (see src/lib/auth/session.ts).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Optional: overrides the callback URL derived from APP_URL. Must exactly match
# the redirect URI registered in Google Cloud and use HTTPS in production.
# GOOGLE_REDIRECT_URI="https://your-domain/api/auth/oauth/google/callback"
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
# Entra tenant: common (multi-tenant + personal), organizations (work/school
# only), consumers, a tenant GUID, or a verified tenant domain.
MICROSOFT_TENANT_ID="common"
# Optional: overrides the callback URL derived from APP_URL. Must exactly match
# the redirect URI registered in Azure and use HTTPS in production.
# MICROSOFT_REDIRECT_URI="https://your-domain/api/auth/oauth/microsoft/callback"

# --- SEO data providers (adapters fall back to mock data until these are set) ---
DATAFORSEO_LOGIN=""
DATAFORSEO_PASSWORD=""
SERP_API_KEY=""
# OPENSERP_API_KEY="" # Alternative alias for SERP_API_KEY

# --- Encryption for stored integration/AI provider keys ---
# AES-256-GCM encryption key for multi-provider API keys (32 bytes hex or base64)
# Generate with: openssl rand -hex 32
# Development example only. Generate a unique key and keep it stable in staging/production.
APP_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
# --- Optional legacy AI provider key ---
ANTHROPIC_API_KEY=""

# --- Billing (Stripe) ---
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Price IDs from your Stripe dashboard, one per plan/interval. Leave unset and that
# plan's checkout will return a clear 501 instead of silently failing.
STRIPE_PRICE_STARTER_MONTHLY=""
STRIPE_PRICE_STARTER_ANNUAL=""
STRIPE_PRICE_GROWTH_MONTHLY=""
STRIPE_PRICE_GROWTH_ANNUAL=""
STRIPE_PRICE_SCALE_MONTHLY=""
STRIPE_PRICE_SCALE_ANNUAL=""

# --- Outbound email (transactional, via Resend) ---
# Leave unset and emails (verification, password reset, team invites) won't be
# sent — the app falls back to showing the link directly instead of failing.
RESEND_API_KEY=""
EMAIL_FROM="Rankly <noreply@yourdomain.com>"
# RESEND_FROM_EMAIL is also accepted when EMAIL_FROM is unset.
