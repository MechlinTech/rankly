# Copy to docker/.env.local for local compose (gitignored):
#   cp docker/.env.example docker/.env.local
#
# Also used as the secret name checklist for GitHub Environments
# (development / production) — see .github/workflows/deploy.yml.

POSTGRES_USER=rankly
POSTGRES_PASSWORD=rankly
POSTGRES_DB=rankly
# Host must be "postgres" inside Compose (not localhost)
DATABASE_URL=postgresql://rankly:vXucFsxjDeP5lju3@postgres:5432/rankly

# Local Docker development key only. Never reuse this value in production.
# The self-hosted deployment workflow provisions a separate persistent key per environment.
APP_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=Rankly <noreply@localhost>

# Microsoft 365 / Entra ID SSO (optional; omit to disable)
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT_ID=organizations
# MICROSOFT_REDIRECT_URI=https://your-domain/api/auth/oauth/microsoft/callback

# Google SSO (optional; omit to disable)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://your-domain/api/auth/oauth/google/callback

# Super-admin login (seeded on migrate). Change these in GitHub Environment secrets.
ADMIN_EMAIL=admin@rankly.local
ADMIN_PASSWORD=RanklyAdmin1
ADMIN_NAME=Platform Admin

# --- GitHub / Docker Hub (CI only, not needed for local compose) ---
# DOCKERHUB_USERNAME=
# DOCKERHUB_TOKEN=
