# Copy to docker/.env.local for local compose (gitignored):
#   cp docker/.env.example docker/.env.local
#
# Also used as the secret name checklist for GitHub Environments
# (development / production) — see .github/workflows/deploy.yml.

POSTGRES_USER=rankly
POSTGRES_PASSWORD=rankly_local_only
POSTGRES_DB=rankly
# Host must be "postgres" inside Compose (not localhost)
DATABASE_URL=postgresql://rankly:rankly_local_only@postgres:5432/rankly

RESEND_API_KEY=
EMAIL_FROM=Rankly <noreply@localhost>

# Super-admin login (seeded on migrate). Change these in GitHub Environment secrets.
ADMIN_EMAIL=admin@rankly.local
ADMIN_PASSWORD=RanklyAdmin1
ADMIN_NAME=Platform Admin

# --- GitHub / Docker Hub (CI only, not needed for local compose) ---
# DOCKERHUB_USERNAME=
# DOCKERHUB_TOKEN=
